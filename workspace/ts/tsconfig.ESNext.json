{
  "compilerOptions": {
    "module": "esnext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react",
    "checkJs": true,
    "allowJs": true,
    "target": "es2023",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declarationDir": "./",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./transpiled/ESNext",
    "lib": ["es2023", "DOM"],
    "types": [ "/opt/jaisocx/sites_docker_environment/workspace/ts/node_modules/@types/node/" ],
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "typings/**/*.d.ts"
  ],
  "exclude": [
    "cloned_repos",
    "express",
    "build_tools",
    "transpiled",
    "node_modules",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.md",
    "**/*.json"
  ]
}
