  <conf-http>
    <servers>

      <server
          port="8447"
          alternative-port="8448"
          secure="true">

        <domain
            name="local.basetasks.site"
            document-root="/opt/jaisocx/sites_docker_environment/workspace"
            jks-path="/opt/jaisocx/sites_docker_environment/v1_2_0/soft_home/jaisocx/v3_0_16/jaisocx-http/etc/https_keys/2026_2027_basetasks_site.jks"
