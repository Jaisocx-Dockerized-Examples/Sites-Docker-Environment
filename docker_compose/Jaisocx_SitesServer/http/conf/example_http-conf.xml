            jks-passphrase="72vNSMvK3YdgphVwUA34DgrbApK9DgDM4koDA42AK7VmYYaAckivmvhMogCPPXh"
            publish-charset="UTF-8" src-charset="UTF-8">

          <alias art="folder"
                 url="/"
                 path="/opt/jaisocx/sites_docker_environment/workspace/cdn_sites/images/Logos_of_Jaisocx/Logo_left/cropped_logo_left"
                 cache="update"
                 list="true"
                 each-folder-content-file-name="logo_Jaisocx_2_title_on_the_right_side.png" />

          <alias art="file"
                 url="/favicon.ico"
                 path="/opt/jaisocx/sites_docker_environment/workspace/cdn_sites/favicon/Icon_Jaisocx.ico"
                 cache="cache"
          />

          <alias art="folder"
                 url="/cdn_sites/"
                 path="/opt/jaisocx/sites_docker_environment/workspace/cdn_sites/"
                 cache="update"
                 list="true"
                 each-folder-content-file-name="root.html" />

          <alias art="folder"
